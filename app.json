{
  "expo": {
    "name": "Mantenimiento IPF",
    "slug": "mantenimiento-ipf",
    "scheme": "mantenimientoipf",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      ["expo-camera", {
        "cameraPermission": "Usamos tu cámara para escanear el QR del aula y fotografiar desperfectos.",
        "microphonePermission": false,
        "recordAudioAndroid": false
      }],
      ["expo-location", {
        "locationWhenInUsePermission": "Usamos tu ubicación para marcar dónde se encuentra el desperfecto."
      }],
      "expo-notifications"
    ],
    "android": {
      "package": "com.ipf.mantenimiento",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": { "bundleIdentifier": "com.ipf.mantenimiento" },
    "experiments": { "typedRoutes": true }
  }
}